Bootstrap: docker
From: nvcr.io/nvidia/cuda:11.8.0-devel-ubuntu20.04

# maDGiCart-CH CUDA build+runtime image for CCR (L40S / sm_89).
# Replaces the broken Docker-only CUDA 11.4 recipe. Build on CCR with:
#   apptainer build --fakeroot --ignore-fakeroot-command madg-cuda-sm89.sif madg-cuda.def
# with APPTAINER_TMPDIR on node-local /scratch (NFS /projects breaks xattr extraction).

%post
    set -e
    echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/00no-sandbox
    export DEBIAN_FRONTEND=noninteractive
    ln -snf /usr/share/zoneinfo/America/New_York /etc/localtime && echo America/New_York > /etc/timezone
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates gnupg g++ gcc make git \
        python3 python3-pip \
        libboost-log-dev libboost-program-options-dev libboost-regex-dev \
        libboost-thread-dev libboost-filesystem-dev
    pip3 install --no-cache-dir 'cmake<4'
    rm -rf /var/lib/apt/lists/*
    export PATH=/usr/local/cuda/bin:${PATH}
    echo "=== toolchain in image ==="; cmake --version; nvcc --version; g++ --version | head -1

%environment
    export LC_ALL=C
    export PATH=/usr/local/cuda/bin:${PATH}
    export CUDA_HOME=/usr/local/cuda
    export LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

%labels
    Project maDGiCart-CH
    Purpose CUDA 11.8 devel + boost; sm_89 / L40S build and runtime
    Base nvcr.io/nvidia/cuda:11.8.0-devel-ubuntu20.04
